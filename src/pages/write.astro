---
import Layout from '../layouts/Layout.astro';
import Editor from '../components/Editor';
---

<Layout title="Write a Post">
  <div class="min-h-screen bg-gradient-to-br from-gray-50 to-white pt-20">
    <div class="max-w-7xl mx-auto px-4 py-8">
      <!-- Header Section -->
      <div class="flex justify-between items-center mb-8 animate-fade-in">
        <h1 class="text-4xl font-bold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
          Create a New Post
        </h1>
        <div class="flex gap-4">
          <button class="btn-muted">
            <span class="mr-2">◯</span> Save Draft
          </button>
          <button class="btn-outline">
            Cancel
          </button>
          <button class="btn-gradient" id="publishBtn">
            <span class="mr-2">↗</span> Publish
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Editor Section -->
        <div class="space-y-6 animate-slide-up">
          <!-- Title Input -->
          <div class="group">
            <input
              type="text"
              placeholder="Enter your post title here..."
              class="w-full px-6 py-4 text-2xl font-bold bg-white rounded-xl border border-gray-200 
                     focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary
                     transition-all duration-300"
              maxlength="100"
            />
            <div class="mt-2 text-sm text-gray-500 text-right transition-opacity group-focus-within:opacity-100 opacity-70">
              <span id="titleCount">0</span>/100 characters
            </div>
          </div>

          <!-- Cover Image Upload -->
          <div class="relative group">
            <div class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center
                        transition-all duration-300 hover:border-primary/50 hover:bg-primary/5">
              <input type="file" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
              <div class="space-y-4">
                <div class="w-16 h-16 mx-auto rounded-full bg-primary/10 flex items-center justify-center">
                  <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-lg font-semibold text-gray-700">Drop your cover image here</p>
                  <p class="text-sm text-gray-500">or click to browse</p>
                </div>
                <p class="text-xs text-gray-400">Supports: PNG, JPG, GIF (Max 10MB)</p>
              </div>
            </div>
          </div>

          <!-- Content Editor -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="border-b border-gray-200 p-4 bg-gray-50">
              <div class="flex gap-2">
                <button class="editor-btn">B</button>
                <button class="editor-btn">I</button>
                <button class="editor-btn">U</button>
                <span class="w-px h-6 bg-gray-300"></span>
                <button class="editor-btn">H1</button>
                <button class="editor-btn">H2</button>
                <span class="w-px h-6 bg-gray-300"></span>
                <button class="editor-btn">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                  </svg>
                </button>
                <button class="editor-btn">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
              </div>
            </div>
            <Editor client:load />
          </div>

          <!-- Tags Input -->
          <div class="space-y-2">
            <label class="text-sm font-medium text-gray-700">Tags</label>
            <div class="relative">
              <input
                type="text"
                placeholder="Add tags separated by commas..."
                class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200
                       focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary
                       transition-all duration-300"
              />
              <div class="mt-2 flex flex-wrap gap-2">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm
                           bg-primary/10 text-primary">
                  technology
                  <button class="ml-2 text-primary/70 hover:text-primary">×</button>
                </span>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm
                           bg-secondary/10 text-secondary">
                  design
                  <button class="ml-2 text-secondary/70 hover:text-secondary">×</button>
                </span>
              </div>
            </div>
          </div>

          <!-- Category & Visibility -->
          <div class="grid grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-sm font-medium text-gray-700">Category</label>
              <select class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200
                           focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary
                           transition-all duration-300">
                <option value="">Select a category</option>
                <option value="technology">Technology</option>
                <option value="design">Design</option>
                <option value="community">Community</option>
              </select>
            </div>
            <div class="space-y-2">
              <label class="text-sm font-medium text-gray-700">Visibility</label>
              <div class="flex gap-4 mt-2">
                <label class="flex items-center">
                  <input type="radio" name="visibility" value="public" checked
                         class="w-4 h-4 text-primary focus:ring-primary/20" />
                  <span class="ml-2 text-sm text-gray-600">Public</span>
                </label>
                <label class="flex items-center">
                  <input type="radio" name="visibility" value="private"
                         class="w-4 h-4 text-primary focus:ring-primary/20" />
                  <span class="ml-2 text-sm text-gray-600">Private</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Preview Section -->
        <div class="hidden lg:block animate-fade-in">
          <div class="sticky top-8">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
              <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold">Preview</h2>
                <div class="flex gap-2">
                  <button class="preview-btn">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                            d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </button>
                  <button class="preview-btn">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                            d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                  </button>
                </div>
              </div>
              <div class="prose prose-sm sm:prose lg:prose-lg max-w-none">
                <p class="text-gray-500 italic">Start writing to see the preview...</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="mt-8 flex justify-between items-center border-t border-gray-200 pt-6 text-sm text-gray-500">
        <div class="flex items-center">
          <span class="w-2 h-2 bg-green-400 rounded-full mr-2"></span>
          Auto-saved 2 minutes ago
        </div>
        <div>
          Word count: <span id="wordCount">0</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .btn-muted {
    @apply px-4 py-2 bg-gray-100 text-gray-600 rounded-lg font-medium
           transition-all duration-300 hover:bg-gray-200 flex items-center;
  }

  .btn-outline {
    @apply px-4 py-2 border border-gray-300 text-gray-700 rounded-lg font-medium
           transition-all duration-300 hover:bg-gray-50;
  }

  .btn-gradient {
    @apply px-4 py-2 bg-gradient-to-r from-primary to-secondary text-white rounded-lg font-medium
           transition-all duration-300 hover:opacity-90 flex items-center;
  }

  .editor-btn {
    @apply p-2 text-gray-600 rounded hover:bg-gray-100 transition-colors duration-200;
  }

  .preview-btn {
    @apply p-2 text-gray-500 rounded hover:bg-gray-100 transition-colors duration-200;
  }

  .animate-fade-in {
    animation: fadeIn 0.5s ease-out;
  }

  .animate-slide-up {
    animation: slideUp 0.5s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Title character counter
  const titleInput = document.querySelector('input[type="text"]') as HTMLInputElement;
  const titleCount = document.getElementById('titleCount');

  if (titleInput && titleCount) {
    titleInput.addEventListener('input', () => {
      titleCount.textContent = titleInput.value.length.toString();
    });
  }

  // Publish button effect
  const publishBtn = document.getElementById('publishBtn');
  if (publishBtn) {
    publishBtn.addEventListener('mouseenter', () => {
      publishBtn.style.transform = 'translateY(-2px)';
    });
    publishBtn.addEventListener('mouseleave', () => {
      publishBtn.style.transform = 'translateY(0)';
    });
  }
</script>