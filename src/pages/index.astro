---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <!-- Hero Section with Gradient and Waves -->
  <section class="relative min-h-[880px] pt-32 bg-gradient-to-br from-primary via-purple-500 to-secondary overflow-hidden ">
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 mt-10">
      <div class="floating-shape shape-1"></div>
      <div class="floating-shape shape-2"></div>
      <div class="floating-shape shape-3"></div>
    </div>
    
    <!-- Hero Content -->
    <div class="relative max-w-7xl mx-auto px-4 py-20 mt-10 text-white text-center">
      <h1 class="text-5xl md:text-7xl font-bold mb-6 animate-fade-in">
        Echoing the Voice of the Community
      </h1>
      <p class="text-xl md:text-2xl mb-12 opacity-90 max-w-2xl mx-auto animate-slide-up">
        Join our vibrant community of writers, thinkers, and creators sharing their unique perspectives.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in">
        <a href="/join" class="btn-primary">
          Join the Community
        </a>
        <a href="/explore" class="btn-secondary">
          Explore Posts
        </a>
      </div>
    </div>
    
    <!-- Wave Divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg class="waves" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320">
        <path fill="#ffffff" fill-opacity="1" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,112C672,96,768,96,864,112C960,128,1056,160,1152,160C1248,160,1344,128,1392,112L1440,96L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
      </svg>
    </div>
  </section>

  <!-- Trending Posts Section -->
  <section class="py-20 bg-gradient-to-b from-white to-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
        Trending Posts
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[1, 2, 3].map(() => (
          <div class="card-hover">
            <div class="bg-white rounded-xl shadow-lg overflow-hidden transform transition-all duration-300 hover:scale-105 hover:shadow-xl">
              <div class="h-48 bg-gradient-to-r from-blue-100 to-purple-100"></div>
              <div class="p-6">
                <h3 class="font-bold text-xl mb-2">Engaging Post Title</h3>
                <p class="text-gray-600 mb-4">
                  Discover insights and perspectives that matter...
                </p>
                <div class="flex items-center text-sm text-gray-500">
                  <span>John Doe</span>
                  <span class="mx-2">•</span>
                  <span>5 min read</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Community Spotlight -->
  <section class="py-20 bg-gradient-radial from-purple-50 via-white to-blue-50 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 relative z-10">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
        Community Spotlight
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white rounded-xl shadow-lg p-8 transform transition-all duration-300 hover:shadow-xl">
          <div class="flex items-center mb-6">
            <div class="w-16 h-16 rounded-full bg-gradient-to-r from-primary to-secondary"></div>
            <div class="ml-4">
              <h3 class="font-bold text-xl">Featured Creator</h3>
              <p class="text-gray-600">Writer & Community Leader</p>
            </div>
          </div>
          <p class="text-gray-600 leading-relaxed">
            Meet our outstanding community member and discover their unique contributions...
          </p>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-8 transform transition-all duration-300 hover:shadow-xl">
          <h3 class="font-bold text-xl mb-4">Latest Achievement</h3>
          <p class="text-gray-600 leading-relaxed mb-4">
            Celebrating the milestones and achievements of our community members...
          </p>
          <a href="/achievements" class="text-primary hover:text-primary-dark font-semibold">
            View All Achievements →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Floating Shapes Animation */
  .floating-shape {
    @apply absolute rounded-full opacity-20 bg-white;
    animation: float 20s infinite linear;
  }
  
  .shape-1 {
    width: 100px;
    height: 100px;
    top: 10%;
    left: 10%;
    animation-delay: -2s;
  }
  
  .shape-2 {
    width: 150px;
    height: 150px;
    top: 20%;
    right: 15%;
    animation-delay: -5s;
  }
  
  .shape-3 {
    width: 80px;
    height: 80px;
    bottom: 30%;
    left: 20%;
    animation-delay: -8s;
  }

  @keyframes float {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      transform: translate(30px, -50px) rotate(120deg);
    }
    66% {
      transform: translate(-20px, 20px) rotate(240deg);
    }
    100% {
      transform: translate(0, 0) rotate(360deg);
    }
  }

  /* Button Styles */
  .btn-primary {
    @apply px-8 py-3 bg-white text-primary font-bold rounded-full 
           transform transition-all duration-300
           hover:scale-105 hover:shadow-lg hover:bg-opacity-90;
  }

  .btn-secondary {
    @apply px-8 py-3 bg-transparent text-white font-bold rounded-full 
           border-2 border-white transform transition-all duration-300
           hover:scale-105 hover:bg-white hover:bg-opacity-10;
  }

  /* Card Hover Animation */
  .card-hover {
    @apply transform transition-all duration-300;
  }

  /* Animations */
  .animate-fade-in {
    animation: fadeIn 1s ease-out;
  }

  .animate-slide-up {
    animation: slideUp 1s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Wave Animation */
  .waves {
    animation: wave 10s cubic-bezier(0.36, 0.45, 0.63, 0.53) infinite;
    transform-origin: center bottom;
  }

  @keyframes wave {
    0% {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(1.1);
    }
    100% {
      transform: scaleX(1);
    }
  }
</style>